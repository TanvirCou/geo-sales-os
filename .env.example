# ==============================================================================
# GeoSales OS — Environment Configuration Template
# ==============================================================================
# Rename or copy this file to `.env.local` or `.env` and fill in the values.

# 1. Database Connection (PostgreSQL is required)
# Local PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/geosales_db?schema=public"
#
# Free Cloud PostgreSQL (Recommended - e.g. Neon.tech / Supabase / Railway):
# DATABASE_URL="postgresql://neondb_owner:password@ep-xyz.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/geosales_db?schema=public"

# 2. Auth & Session Secret (Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
SESSION_SECRET="e4d6f8a1c3b5e7f9a2d4c6e8b0a1c3e5f7a9b1c3d5e7f9a1b3c5d7e9f1a3b5c7"

# 3. Admin PIN Hash (Default 6-digit PIN: 123456 -> hashed with: npm run hash-pin 123456)
ADMIN_PIN_HASH="$2a$10$wT8mQyvGZp/aXoW1l2bMxe4J3s.lM1/1D9FqM8a.zX7E8m.V3Q5b."

# 4. Map Providers (Optional for local testing, required for map features)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAP_ID=""
GOOGLE_MAPS_SERVER_API_KEY=""

NEXT_PUBLIC_GEOAPIFY_API_KEY=""
GEOAPIFY_SERVER_API_KEY=""

# 5. Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

