// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth & Team ─────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MODERATOR
  MARKETER
  CUSTOM
}

model User {
  id             String        @id @default(uuid())
  name           String
  phone          String        @unique
  pinHash        String        @map("pin_hash")
  role           UserRole      @default(MARKETER)
  permissions    Json?         // Custom permission flags for CUSTOM role
  isActive       Boolean       @default(true) @map("is_active")
  failedAttempts Int           @default(0) @map("failed_attempts")
  lockedUntil    DateTime?     @map("locked_until")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  sessions       UserSession[]

  @@map("users")
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("user_sessions")
}

model AdminCredential {
  id            String   @id @default(uuid())
  name          String?  @default("Admin User")
  pinHash       String   @map("pin_hash")
  failedAttempts Int     @default(0) @map("failed_attempts")
  lockedUntil   DateTime? @map("locked_until")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("admin_credentials")
}

model AdminSession {
  id        String   @id @default(uuid())
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_sessions")
}

// ─── Domain Tables ───────────────────────────────────────────────────────────

model Business {
  id                   String    @id @default(uuid())
  name                 String
  category             String?
  area                 String?   // fine locality e.g. Dhanmondi, Uttara
  district             String?   // administrative district e.g. Dhaka
  contactName          String?   @map("contact_name")
  phoneRaw             String?   @map("phone_raw")
  phoneNormalized      String?   @map("phone_normalized")
  address              String?
  latitude             Decimal?  @db.Decimal(10, 7)
  longitude            Decimal?  @db.Decimal(10, 7)
  coordinateSource     String?   @map("coordinate_source")
  coordinateSourceRef  String?   @map("coordinate_source_ref")
  placeProvider        String?   @map("place_provider")
  externalPlaceId      String?   @map("external_place_id")
  isActive             Boolean   @default(true) @map("is_active")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  orders               Order[]

  @@index([placeProvider, externalPlaceId])
  @@index([category])
  @@index([area])
  @@index([district])
  @@index([isActive])
  @@index([phoneNormalized])
  @@index([name])
  @@map("businesses")
}

model Product {
  id         String      @id @default(uuid())
  name       String
  sku        String?
  unit       String?
  priceBdt   Decimal?    @db.Decimal(14, 2) @map("price_bdt")
  isActive   Boolean     @default(true) @map("is_active")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  orderItems OrderItem[]

  @@map("products")
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  RETURNED
  PARTIAL
  UNKNOWN
}

model Order {
  id               String      @id @default(uuid())
  businessId       String      @map("business_id")
  orderedAt        DateTime?   @map("ordered_at")
  status           OrderStatus @default(PENDING)
  source           String?
  sourceStatusRaw  String?     @map("source_status_raw")
  externalOrderId  String?     @map("external_order_id")
  totalAmountBdt   Decimal?    @db.Decimal(14, 2) @map("total_amount_bdt")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  business         Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  items            OrderItem[]

  @@unique([source, externalOrderId], name: "unique_source_order")
  @@index([businessId])
  @@index([status])
  @@index([orderedAt])
  @@map("orders")
}

model OrderItem {
  id                String   @id @default(uuid())
  orderId           String   @map("order_id")
  productId         String?  @map("product_id")
  sourceProductName String?  @map("source_product_name")
  quantity          Decimal  @db.Decimal(12, 3)
  unitPriceBdt      Decimal  @db.Decimal(14, 2) @map("unit_price_bdt")
  createdAt         DateTime @default(now()) @map("created_at")

  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ─── Import Jobs (Phase 7) ────────────────────────────────────────────────────

model ImportBatch {
  id          String   @id @default(uuid())
  fileKey     String   @map("file_key")
  checksum    String?
  status      String   @default("pending")
  columnMap   Json?    @map("column_map")
  progress    Json?
  errorLog    Json?    @map("error_log")
  importedCount Int    @default(0) @map("imported_count")
  duplicateCount Int   @default(0) @map("duplicate_count")
  reviewCount Int      @default(0) @map("review_count")
  failedCount Int      @default(0) @map("failed_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("import_batches")
}
